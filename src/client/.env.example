# API URLs
VITE_API_URL=http://localhost:3000
VITE_ADMIN_API_URL=https://mysys.shop
VITE_PORTAL_URL=https://mysys.shop
VITE_AUTH_URL=https://mysys.shop

# Game identification for games-admin
VITE_GAME_CODE=BANGSHOT

# Game API Key (for bug reports SDK)
VITE_GAME_API_KEY=your-game-api-key-here

# OAuth 2.0 + PKCE Configuration
VITE_OAUTH_CLIENT_ID=BANGSHOT
VITE_OAUTH_AUTHORIZE_URL=https://mysys.shop/oauth/authorize
VITE_OAUTH_REDIRECT_URI=https://bangshot.mysys.shop/auth/callback

# AdSense Configuration
VITE_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT_LANDING=1234567890
VITE_ADSENSE_SLOT_LOBBY=1234567891
VITE_ADSENSE_SLOT_LEADERBOARD=1234567892
VITE_ADSENSE_SLOT_HEADER=1234567893
VITE_ADSENSE_SLOT_FOOTER=1234567894
VITE_ADSENSE_TEST_MODE=true

# Reverb WebSocket (Real-time auth sync)
VITE_REVERB_APP_KEY=your-reverb-app-key
VITE_REVERB_HOST=mysys.shop
VITE_REVERB_PORT=443
VITE_REVERB_FORCE_TLS=true

# Google Analytics (GA4)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
