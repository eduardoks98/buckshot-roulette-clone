# Server
PORT=3000
NODE_ENV=development

# Database (MySQL)
DATABASE_URL="mysql://root:your_password@localhost:3306/buckshot_roulette"

# Session
SESSION_SECRET=your_session_secret_here

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Games Admin Integration
GAMES_ADMIN_API_URL=https://mysys.shop
GAMES_ADMIN_API_KEY=your-api-key-here
GAMES_ADMIN_JWT_SECRET=your-jwt-secret-here
GAME_CODE=BANGSHOT

# OAuth 2.0 (SSO with Portal)
OAUTH_CLIENT_ID=BANGSHOT
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_AUTHORIZE_URL=https://mysys.shop/oauth/authorize
OAUTH_TOKEN_URL=https://mysys.shop/oauth/token
OAUTH_REDIRECT_URI=https://bangshot.mysys.shop/auth/callback
